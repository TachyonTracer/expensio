// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = "postgresql://postgres:admin@localhost:5432/expensio_db?schema=public"
}

model Company {
  id           String   @id @default(uuid())
  name         String
  country      String
  baseCurrency String   @map("base_currency")
  industry     String?  @map("industry")
  employeeCount String? @map("employee_count")
  timeZone     String?  @map("time_zone")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Relations
  users         User[]
  expenses      Expense[]
  approvalRules ApprovalRule[]

  @@index([country])
  @@index([createdAt])
  @@map("companies")
}

model User {
  id        String   @id @default(uuid())
  companyId String   @map("company_id")
  email     String   @unique
  password  String
  role      UserRole
  managerId String?  @map("manager_id")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  company          Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  manager          User?       @relation("UserManager", fields: [managerId], references: [id])
  directReports    User[]      @relation("UserManager")
  expenses         Expense[]
  approvals        Approval[]
  approvalSteps    ApprovalStep[]

  @@index([companyId])
  @@index([role])
  @@index([managerId])
  @@index([isActive])
  @@index([companyId, role])
  @@map("users")
}

model Expense {
  id               String        @id @default(uuid())
  companyId        String        @map("company_id")
  userId           String        @map("user_id")
  originalAmount   Decimal       @map("original_amount")
  originalCurrency String        @map("original_currency")
  convertedAmount  Decimal       @map("converted_amount")
  baseCurrency     String        @map("base_currency")
  exchangeRate     Decimal       @map("exchange_rate")
  category         String
  description      String
  expenseDate      DateTime      @map("expense_date")
  status           ExpenseStatus @default(DRAFT)
  receiptId        String?       @unique @map("receipt_id")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  // Relations
  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  receipt   Receipt?
  approvals Approval[]

  @@index([companyId])
  @@index([userId])
  @@index([status])
  @@index([category])
  @@index([expenseDate])
  @@index([companyId, status])
  @@index([userId, status])
  @@index([companyId, expenseDate])
  @@map("expenses")
}

model Receipt {
  id        String   @id @default(uuid())
  expenseId String   @unique @map("expense_id")
  filePath  String   @map("file_path")
  fileName  String   @map("file_name")
  mimeType  String   @map("mime_type")
  ocrData   Json?    @map("ocr_data")
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  expense Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)

  @@index([mimeType])
  @@index([createdAt])
  @@map("receipts")
}

model ApprovalRule {
  id         String            @id @default(uuid())
  companyId  String            @map("company_id")
  name       String
  minAmount  Decimal?          @map("min_amount")
  maxAmount  Decimal?          @map("max_amount")
  category   String?
  ruleType   ApprovalRuleType  @map("rule_type")
  ruleConfig Json              @map("rule_config")
  isActive   Boolean           @default(true) @map("is_active")
  createdAt  DateTime          @default(now()) @map("created_at")
  updatedAt  DateTime          @updatedAt @map("updated_at")

  // Relations
  company       Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  approvalSteps ApprovalStep[]

  @@index([companyId])
  @@index([isActive])
  @@index([ruleType])
  @@index([category])
  @@index([companyId, isActive])
  @@map("approval_rules")
}

model ApprovalStep {
  id           String       @id @default(uuid())
  ruleId       String       @map("rule_id")
  stepOrder    Int          @map("step_order")
  approverId   String       @map("approver_id")
  approverType ApproverType @map("approver_type")
  isRequired   Boolean      @default(true) @map("is_required")
  createdAt    DateTime     @default(now()) @map("created_at")

  // Relations
  rule      ApprovalRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  approver  User         @relation(fields: [approverId], references: [id], onDelete: Cascade)
  approvals Approval[]

  @@index([ruleId])
  @@index([approverId])
  @@index([stepOrder])
  @@index([ruleId, stepOrder])
  @@map("approval_steps")
}

model Approval {
  id         String         @id @default(uuid())
  expenseId  String         @map("expense_id")
  stepId     String         @map("step_id")
  approverId String         @map("approver_id")
  status     ApprovalStatus @default(PENDING)
  comments   String?
  approvedAt DateTime?      @map("approved_at")
  createdAt  DateTime       @default(now()) @map("created_at")

  // Relations
  expense  Expense      @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  step     ApprovalStep @relation(fields: [stepId], references: [id], onDelete: Cascade)
  approver User         @relation(fields: [approverId], references: [id], onDelete: Cascade)

  @@index([expenseId])
  @@index([stepId])
  @@index([approverId])
  @@index([status])
  @@index([expenseId, status])
  @@index([approverId, status])
  @@map("approvals")
}

model Currency {
  code        String   @id
  name        String
  symbol      String
  exchangeRate Decimal @map("exchange_rate")
  lastUpdated DateTime @default(now()) @map("last_updated")

  @@index([lastUpdated])
  @@map("currencies")
}

// Enums
enum UserRole {
  ADMIN
  MANAGER
  EMPLOYEE
}

enum ExpenseStatus {
  DRAFT
  SUBMITTED
  PENDING_APPROVAL
  APPROVED
  REJECTED
  REIMBURSED
}

enum ApprovalRuleType {
  PERCENTAGE
  SPECIFIC_APPROVER
  HYBRID
}

enum ApproverType {
  USER
  ROLE
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}